generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MailboxProvider {
  MICROSOFT_365
}

enum MailboxStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum TicketStatus {
  OPEN
  ON_HOLD
  FOLLOWING_UP
  IN_PROGRESS
  ANSWERED
  AWAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketSource {
  EMAIL
  MANUAL
  API
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TicketDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  EMAIL
  PLATFORM
  SYSTEM
}

enum SenderType {
  CUSTOMER
  AGENT
  SYSTEM
}


model Organization {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  departments Department[]
  mailboxes   Mailbox[]
  tickets     Ticket[]

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(USER)
  departmentId   String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  assignedTickets Ticket[]       @relation("AssignedAgent")
  ticketMessages  TicketMessage[] @relation("MessageAuthor")

  @@index([organizationId])
  @@map("users")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  tickets      Ticket[]
  emailTemplates EmailTemplate[]

  @@index([organizationId])
  @@map("departments")
}

model Mailbox {
  id             String          @id @default(uuid())
  organizationId String
  email          String
  provider       MailboxProvider @default(MICROSOFT_365)
  tenantId       String?
  status         MailboxStatus   @default(PENDING)
  lastSyncAt     DateTime?
  deltaToken     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]

  @@unique([organizationId, email])
  @@map("mailboxes")
}


model Ticket {
  id             String         @id @default(uuid())
  ticketNumber   String         @unique
  organizationId String
  departmentId   String?
  mailboxId      String?
  subject        String
  requesterEmail String
  requesterName  String?
  direction      TicketDirection @default(INBOUND)
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  assignedToId   String?
  source         TicketSource   @default(MANUAL)
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  mailbox      Mailbox?     @relation(fields: [mailboxId], references: [id])
  assignedTo   User?        @relation("AssignedAgent", fields: [assignedToId], references: [id])

  messages    TicketMessage[]
  attachments Attachment[]

  @@index([organizationId, status])
  @@index([requesterEmail])
  @@map("tickets")
}

model TicketMessage {
  id                String            @id @default(uuid())
  ticketId          String
  authorId          String?
  providerMessageId String?
  internetMessageId String?
  conversationId    String?
  direction         MessageDirection
  source            MessageSource
  senderType        SenderType
  fromEmail         String
  fromName          String?
  toEmails          String[]
  ccEmails          String[]
  subject           String?
  bodyHtml          String?
  bodyText          String?
  isInternal        Boolean           @default(false)
  sentAt            DateTime?
  createdAt         DateTime          @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id])
  author      User?        @relation("MessageAuthor", fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
  @@unique([internetMessageId])
  @@map("ticket_messages")
}

model Attachment {
  id              String   @id @default(uuid())
  ticketId        String
  ticketMessageId String?
  fileName        String
  mimeType        String
  size            Int
  storageKey      String
  checksum        String?
  createdAt       DateTime @default(now())

  ticket        Ticket         @relation(fields: [ticketId], references: [id])
  ticketMessage TicketMessage? @relation(fields: [ticketMessageId], references: [id])

  @@index([ticketId])
  @@map("attachments")
}



model EmailTemplate {
  id           String     @id @default(uuid())
  title        String
  subject      String?
  body         String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}
